 :control_text=>"Changes to security policies are communicated to relevant stakeholders"}, {:control_id=>"PNC 21", :control_text=>"Periodic enterprise risk assessments are performed"}, {:control_id=>"PNC 22", :control_text=>"Identified risks are documented and reviewed by management"}, {:control_id=>"PNC 23", :control_text=>"Risk treatment decisions are recorded and tracked"}, {:control_id=>"PNC 24", :control_text=>"System logs are collected and monitored"}, {:control_id=>"PNC 25", :control_text=>"Alerts are configured for anomalous system activity"}, {:control_id=>"PNC 26", :control_text=>"Vendors are evaluated during onboarding"}, {:control_id=>"PNC 27", :control_text=>"Vendor reviews are conducted periodically"}, {:control_id=>"PNC 28", :control_text=>"Identified vendor risks are documented and tracked"}, {:control_id=>"PNC 29", :control_text=>"System uptime is monitored"}, {:control_id=>"PNC 30", :control_text=>"Backup procedures are documented and performed"}, {:control_id=>"PNC 31", :control_text=>"Disaster recovery plans exist and are reviewed periodically"}, {:control_id=>"PNC 32", :control_text=>"Sensitive data is classified internally"}, {:control_id=>"PNC 33", :control_text=>"Access to sensitive data is restricted based on roles"}, {:control_id=>"PNC 34", :control_text=>"Data retention policies are documented"}, {:control_id=>"PNC 35", :control_text=>"Managing user access permissions"}, {:control_id=>"PNC 36", :control_text=>"Securing end-user devices"}, {:control_id=>"PNC 37", :control_text=>"Configuring integrations appropriately"}]
