[ControlsController] response: {:source_controls=>[{:normalised_control_text=>"The company performs background checks on new employees.", :control_ids=>["CC 1.1", "CC 1.4"]}, {:normalised_control_text=>"The company requires contractor agreements to include a code of conduct or reference to the company code of conduct.", :control_ids=>["CC 1.1"]}, {:normalised_control_text=>"The company requires employees to acknowledge a code of conduct at the time of hire. Employees who violate the code of conduct are subject to disciplinary actions in accordance with a disciplinary policy.", :control_ids=>["CC 1.1", "CC 1.5"]}, {:normalised_control_text=>"The company requires contractors to sign a confidentiality agreement at the time of engagement.", :control_ids=>["CC 1.1"]}, {:normalised_control_text=>"The company requires employees to sign a confidentiality agreement during onboarding.", :control_ids=>["CC 1.1"]}, {:normalised_control_text=>"The company managers are required to complete performance evaluations for direct reports at least annually.", :control_ids=>["CC 1.1", "CC 1.4", "CC 1.5"]}, {:normalised_control_text=>"The company's board of directors has a documented charter that outlines its oversight responsibilities for internal control.", :control_ids=>["CC 1.2", "CC 1.3"]}, {:normalised_control_text=>"The company's board of directors or a relevant subcommittee is briefed by senior management at least annually on the state of the company's cybersecurity and privacy risk. The board provides feedback and direction to management as needed.", :control_ids=>["CC 1.2"]}, {:normalised_control_text=>"The company management has established defined roles and responsibilities to oversee the design and implementation of information security controls.", :control_ids=>["CC 1.3", "CC 2.2"]}, {:normalised_control_text=>"The company requires employees to complete security awareness training within thirty days of hire and at least annually thereafter.", :control_ids=>["CC 1.4", "CC 2.2"]}, {:normalised_control_text=>"The company utilizes a log management tool to identify events that may have a potential impact on the company's ability to achieve its security objectives.", :control_ids=>["CC 2.1", "CC 7.2"]}, {:normalised_control_text=>"Host-based vulnerability scans are performed at least quarterly on all external-facing systems. Critical and high vulnerabilities are tracked to remediation.", :control_ids=>["CC 2.1", "CC 4.1", "CC 7.1", "CC 7.2", "CC 7.4", "CC 8.1"]}, {:normalised_control_text=>"The company performs control self-assessments at least annually to gain assurance that controls are in place and operating effectively. Corrective actions are taken based on relevant findings. If the company has committed to an SLA for a finding, the corrective action is completed within that SLA.", :control_ids=>["CC 2.1", "CC 4.1", "CC 4.2"]}, {:normalised_control_text=>"The company's information security policies and procedures are documented and reviewed at least annually.", :control_ids=>["CC 2.2", "CC 5.1", "CC 5.2", "CC 5.3"]}, {:normalised_control_text=>"The company has an external-facing support system in place that allows users to report system information on failures, incidents, concerns, and other complaints to appropriate personnel.", :control_ids=>["CC 2.3"]}, {:normalised_control_text=>"The company notifies customers of critical system changes that may affect their processing.", :control_ids=>["CC 2.3"]}, {:normalised_control_text=>"The company has written agreements in place with vendors and related third-parties. These agreements include confidentiality and privacy commitments applicable to that entity.", :control_ids=>["CC 2.3", "CC 9.2"]}, {:normalised_control_text=>"The company has a documented risk management program in place that includes guidance on the identification of potential threats, rating the significance of the risks associated with the identified threats, and mitigation strategies for those risks.", :control_ids=>["CC 3.1", "CC 3.2", "CC 3.3", "CC 3.4", "CC 5.1", "CC 5.3", "CC 9.1"]}, {:normalised_control_text=>"The company has a vendor management program in place. Components of this program include:\n- critical third-party vendor inventory;\n- vendor's security and privacy requirements; and\n- review of critical third-party vendors at least annually.", :control_ids=>["CC 3.2", "CC 4.1", "CC 4.2", "CC 5.3", "CC 9.2"]}, {:normalised_control_text=>"The company has a documented business continuity/disaster recovery (BC/DR) plan and tests it at least annually.", :control_ids=>["CC 3.2", "CC 7.5"]}, {:normalised_control_text=>"The company's risk assessments are performed at least annually. As part of this process, threats and changes (environmental, regulatory, and technological) to service commitments are identified and the risks are formally assessed. The risk assessment includes a consideration of the potential for fraud and how fraud may impact the achievement of objectives.", :control_ids=>["CC 3.2", "CC 3.3", "CC 3.4", "CC 7.1", "CC 9.1"]}, {:normalised_control_text=>"The company has a formal systems development life cycle (SDLC) methodology in place that governs the development, acquisition, implementation, changes (including emergency changes), and maintenance of information systems and related technology requirements.", :control_ids=>["CC 5.2", "CC 5.3", "CC 6.8", "CC 8.1"]}, {:normalised_control_text=>"The company's access control policy documents the requirements for the following access control functions: \n- adding new users;\n- modifying users; and/or \n- removing an existing user's access.", :control_ids=>["CC 5.2", "CC 6.1", "CC 6.2", "CC 6.3"]}, {:normalised_control_text=>"The company's data backup policy documents requirements for backup and recovery of customer data.", :control_ids=>["CC 5.3"]}, {:normalised_control_text=>"The company requires changes to software and infrastructure components of the service to be authorized, formally documented, tested, reviewed, and approved prior to being implemented in the production environment.", :control_ids=>["CC 5.3", "CC 7.1", "CC 8.1"]}, {:normalised_control_text=>"The company has formal retention and disposal procedures in place to guide the secure retention and disposal of company and customer data.", :control_ids=>["CC 5.3", "CC 6.5"]}, {:normalised_control_text=>"The company's network is segmented to prevent unauthorized access to customer data.", :control_ids=>["CC 6.1"]}, {:normalised_control_text=>"The company's production systems can only be remotely accessed by authorized employees via an approved encrypted connection.", :control_ids=>["CC 6.1", "CC 6.6"]}, {:normalised_control_text=>"The company's datastores housing sensitive customer data are encrypted at rest.", :control_ids=>["CC 6.1"]}, {:normalised_control_text=>"The company's production systems can only be remotely accessed by authorized employees possessing a valid multi-factor authentication (MFA) method.", :control_ids=>["CC 6.1", "CC 6.6"]}, {:normalised_control_text=>"The company requires passwords for in-scope system components to be configured according to the company's policy.", :control_ids=>["CC 6.1"]}, {:normalised_control_text=>"The company has a data classification policy in place to help ensure that confidential data is properly secured and restricted to authorized personnel.", :control_ids=>["CC 6.1"]}, {:normalised_control_text=>"The company completes termination checklists to ensure that access is revoked for terminated employees within SLAs.", :control_ids=>["CC 6.2", "CC 6.3", "CC 6.5"]}, {:normalised_control_text=>"The company conducts access reviews at least quarterly for the in-scope system components to help ensure that access is restricted appropriately. Required changes are tracked to completion.", :control_ids=>["CC 6.2", "CC 6.3", "CC 6.4"]}, {:normalised_control_text=>"The company purges or removes customer data containing confidential information from the application environment, in accordance with best practices, when customers leave the service.", :control_ids=>["CC 6.5"]}, {:normalised_control_text=>"The company has electronic media containing confidential information purged or destroyed in accordance with best practices, and certificates of destruction are issued for each device destroyed.", :control_ids=>["CC 6.5"]}, {:normalised_control_text=>"The company has infrastructure supporting the service patched as a part of routine maintenance and as a result of identified vulnerabilities to help ensure that servers supporting the service are hardened against security threats.", :control_ids=>["CC 6.6", "CC 6.8", "CC 7.2", "CC 7.4", "CC 8.1"]}, {:normalised_control_text=>"The company uses an intrusion detection system to provide continuous monitoring of the company's network and early detection of potential security breaches.", :control_ids=>["CC 6.6", "CC 7.2"]}, {:normalised_control_text=>"The company uses secure data transmission protocols to encrypt confidential and sensitive data when transmitted over public networks.", :control_ids=>["CC 6.6", "CC 6.7"]}, {:normalised_control_text=>"The company reviews its firewall rulesets at least annually. Required changes are tracked to completion.", :control_ids=>["CC 6.6"]}, {:normalised_control_text=>"The company has a mobile device management (MDM) system in place to centrally manage mobile devices supporting the service.", :control_ids=>["CC 6.7"]}, {:normalised_control_text=>"The company encrypts portable and removable media devices when used.", :control_ids=>["CC 6.7"]}, {:normalised_control_text=>"The company deploys anti-malware technology to environments commonly susceptible to malicious attacks and configures this to be updated routinely, logged, and installed on all relevant systems.", :control_ids=>["CC 6.8"]}, {:normalised_control_text=>"The company's formal policies outline the requirements for the following functions related to IT / Engineering: \n- vulnerability management;\n- system monitoring.", :control_ids=>["CC 7.1", "CC 7.2"]}, {:normalised_control_text=>"An infrastructure monitoring tool is utilized to monitor systems, infrastructure, and performance and generates alerts when specific predefined thresholds are met.", :control_ids=>["CC 7.2"]}, {:normalised_control_text=>"The company's security and privacy incidents are logged, tracked, resolved, and communicated to affected or relevant parties by management according to the company's security incident response policy and procedures.", :control_ids=>["CC 7.3", "CC 7.4", "CC 7.5"]}, {:normalised_control_text=>"The company tests their incident response plan at least annually.", :control_ids=>["CC 7.4", "CC 7.5"]}, {:normalised_control_text=>"The company maintains cybersecurity insurance to mitigate the financial impact of business disruptions.", :control_ids=>["CC 9.1"]}, {:normalised_control_text=>"The company has processes in place for granting, changing, and terminating physical access to company data centers based on an authorization from control owners.", :control_ids=>["CC 6.4"]}, {:normalised_control_text=>"The company has security and privacy incident response policies and procedures that are documented and communicated to authorized users.", :control_ids=>["CC 2.2", "CC 5.3", "CC 7.3", "CC 7.4", "CC 7.5"]}, {:normalised_control_text=>"The company specifies its objectives to enable the identification and assessment of risk related to the objectives.", :control_ids=>["CC 3.1", "CC 5.3"]}], :pdf_extracted_controls=>[{:control_id=>"PNC 1", :control_text=>"Encryption in transit using TLS"}, {:control_id=>"PNC 2", :control_text=>"Encryption at rest using cloud provider–managed encryption mechanisms"}, {:control_id=>"PNC 3", :control_text=>"Organizational policies define acceptable use, security expectations, and employee conduct"}, {:control_id=>"PNC 4", :control_text=>"Roles and responsibilities related to security are documented"}, {:control_id=>"PNC 5", :control_text=>"Employees receive onboarding training and periodic security awareness training"}, {:control_id=>"PNC 6", :control_text=>"Policies and procedures are documented and communicated internally"}, {:control_id=>"PNC 7", :control_text=>"Security incidents can be reported through defined channels"}, {:control_id=>"PNC 8", :control_text=>"Changes to security policies are communicated to relevant stakeholders"}, {:control_id=>"PNC 9", :control_text=>"Periodic enterprise risk assessments are performed"}, {:control_id=>"PNC 10", :control_text=>"Identified risks are documented and reviewed by management"}, {:control_id=>"PNC 11", :control_text=>"Risk treatment decisions are recorded and tracked"}, {:control_id=>"PNC 12", :control_text=>"System logs are collected and monitored"}, {:control_id=>"PNC 13", :control_text=>"Alerts are configured for anomalous system activity"}, {:control_id=>"PNC 14", :control_text=>"Control performance is periodically reviewed by management"}, {:control_id=>"PNC 15", :control_text=>"Change management processes govern system updates"}, {:control_id=>"PNC 16", :control_text=>"Code changes are reviewed and approved prior to deployment"}, {:control_id=>"PNC 17", :control_text=>"Infrastructure changes are tracked and documented"}, {:control_id=>"PNC 18", :control_text=>"Role-based access control is implemented for systems"}, {:control_id=>"PNC 19", :control_text=>"Multi-factor authentication is required for privileged access"}, {:control_id=>"PNC 20", :control_text=>"Access provisioning and deprovisioning procedures are documented"}, {:control_id=>"PNC 21", :control_text=>"Incident response procedures are documented"}, {:control_id=>"PNC 22", :control_text=>"Security incidents are logged and tracked to resolution"}, {:control_id=>"PNC 23", :control_text=>"Operational responsibilities are defined and assigned"}, {:control_id=>"PNC 24", :control_text=>"Changes are tested prior to deployment"}, {:control_id=>"PNC 25", :control_text=>"Emergency changes are documented following implemen