sed_control_text=>"The company's data backup policy documents requirements for backup and recovery of customer data."}, {:control_ids=>["CC 5.3", "CC 7.1", "CC 8.1"], :normalised_control_text=>"The company requires changes to software and infrastructure components of the service to be authorized, formally documented, tested, reviewed, and approved prior to being implemented in the production environment."}, {:control_ids=>["CC 5.3", "CC 6.5"], :normalised_control_text=>"The company has formal retention and disposal procedures in place to guide the secure retention and disposal of company and customer data."}, {:control_ids=>["CC 6.1"], :normalised_control_text=>"The company's network is segmented to prevent unauthorized access to customer data."}, {:control_ids=>["CC 6.1", "CC 6.6"], :normalised_control_text=>"The company's production systems can only be remotely accessed by authorized employees via an approved encrypted connection."}, {:control_ids=>["CC 6.1"], :normalised_control_text=>"The company's datastores housing sensitive customer data are encrypted at rest."}, {:control_ids=>["CC 6.1", "CC 6.6"], :normalised_control_text=>"The company's production systems can only be remotely accessed by authorized employees possessing a valid multi-factor authentication (MFA) method."}, {:control_ids=>["CC 6.1"], :normalised_control_text=>"The company requires passwords for in-scope system components to be configured according to the company's policy."}, {:control_ids=>["CC 6.1"], :normalised_control_text=>"The company has a data classification policy in place to help ensure that confidential data is properly secured and restricted to authorized personnel."}, {:control_ids=>["CC 6.2", "CC 6.3", "CC 6.5"], :normalised_control_text=>"The company completes termination checklists to ensure that access is revoked for terminated employees within SLAs."}, {:control_ids=>["CC 6.2", "CC 6.3", "CC 6.4"], :normalised_control_text=>"The company conducts access reviews at least quarterly for the in-scope system components to help ensure that access is restricted appropriately. Required changes are tracked to completion."}, {:control_ids=>["CC 6.5"], :normalised_control_text=>"The company purges or removes customer data containing confidential information from the application environment, in accordance with best practices, when customers leave the service."}, {:control_ids=>["CC 6.5"], :normalised_control_text=>"The company has electronic media containing confidential information purged or destroyed in accordance with best practices, and certificates of destruction are issued for each device destroyed."}, {:control_ids=>["CC 6.6", "CC 6.8", "CC 7.2", "CC 7.4", "CC 8.1"], :normalised_control_text=>"The company has infrastructure supporting the service patched as a part of routine maintenance and as a result of identified vulnerabilities to help ensure that servers supporting the service are hardened against security threats."}, {:control_ids=>["CC 6.6", "CC 7.2"], :normalised_control_text=>"The company uses an intrusion detection system to provide continuous monitoring of the company's network and early detection of potential security breaches."}, {:control_ids=>["CC 6.6", "CC 6.7"], :normalised_control_text=>"The company uses secure data transmission protocols to encrypt confidential and sensitive data when transmitted over public networks."}, {:control_ids=>["CC 6.6"], :normalised_control_text=>"The company reviews its firewall rulesets at least annually. Required changes are tracked to completion."}, {:control_ids=>["CC 6.7"], :normalised_control_text=>"The company has a mobile device management (MDM) system in place to centrally manage mobile devices supporting the service."}, {:control_ids=>["CC 6.7"], :normalised_control_text=>"The company encrypts portable and removable media devices when used."}, {:control_ids=>["CC 6.8"], :normalised_control_text=>"The company deploys anti-malware technology to environments commonly susceptible to malicious attacks and configures this to be updated routinely, logged, and installed on all relevant systems."}, {:control_ids=>["CC 7.1", "CC 7.2"], :normalised_control_text=>"The company's formal policies outline the requirements for the following functions related to IT / Engineering: \n- vulnerability management;\n- system monitoring."}, {:control_ids=>["CC 7.2"], :normalised_control_text=>"An infrastructure monitoring tool is utilized to monitor systems, infrastructure, and performance and generates alerts when specific predefined thresholds are met."}, {:control_ids=>["CC 7.3", "CC 7.4", "CC 7.5"], :normalised_control_text=>"The company's security and privacy incidents are logged, tracked, resolved, and communicated to affected or relevant parties by management according to the company's security incident response policy and procedures."}, {:control_ids=>["CC 7.4", "CC 7.5"], :normalised_control_text=>"The company tests their incident response plan at least annually."}, {:control_ids=>["CC 9.1"], :normalised_control_text=>"The company maintains cybersecurity insurance to mitigate the financial impact of business disruptions."}, {:control_ids=>["CC 6.4"], :normalised_control_text=>"The company has processes in place for granting, changing, and terminating physical access to company data centers based on an authorization from control owners."}, {:control_ids=>["CC 2.2", "CC 5.3", "CC 7.3", "CC 7.4", "CC 7.5"], :normalised_control_text=>"The company has security and privacy incident response policies and procedures that are documented and communicated to authorized users."}, {:control_ids=>["CC 3.1", "CC 5.3"], :normalised_control_text=>"The company specifies its objectives to enable the identification and assessment of risk related to the objectives."}], :unmatched_normalized_controls=>[]}}
