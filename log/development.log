e_row_index"=>29, "source_normalised_control_text"=>"The company's production systems can only be remotely accessed by authorized employees possessing a valid multi-factor authentication (MFA) method.", "normalized_common_control_ids"=>["UNC 3", "UNC 5"], "match_type"=>"partial", "rationale"=>"MFA for production systems partially matches authentication requirements but is specific to remote access and MFA."}, {"source_row_index"=>30, "source_normalised_control_text"=>"The company requires passwords for in-scope system components to be configured according to the company's policy.", "normalized_common_control_ids"=>["UNC 12"], "match_type"=>"full", "rationale"=>"Direct match on password requirements for in-scope systems."}, {"source_row_index"=>31, "source_normalised_control_text"=>"The company has a data classification policy in place to help ensure that confidential data is properly secured and restricted to authorized personnel.", "normalized_common_control_ids"=>["UNC 2"], "match_type"=>"full", "rationale"=>"Direct match on data classification policy."}, {"source_row_index"=>38, "source_normalised_control_text"=>"The company uses secure data transmission protocols to encrypt confidential and sensitive data when transmitted over public networks.", "normalized_common_control_ids"=>["UNC 23"], "match_type"=>"full", "rationale"=>"Direct match on secure data transmission protocols."}, {"source_row_index"=>41, "source_normalised_control_text"=>"The company encrypts portable and removable media devices when used.", "normalized_common_control_ids"=>["UNC 13"], "match_type"=>"full", "rationale"=>"Direct match on encrypting portable and removable media."}, {"source_row_index"=>42, "source_normalised_control_text"=>"The company deploys anti-malware technology to environments commonly susceptible to malicious attacks and configures this to be updated routinely, logged, and installed on all relevant systems.", "normalized_common_control_ids"=>["UNC 10"], "match_type"=>"full",